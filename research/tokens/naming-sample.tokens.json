  "type": {
    "$type": "typography",
    "$description": "Roles, not sizes. Korean body defaults to Pretendard. Desktop values; mobile overrides belong in a mode, not in new roles.",
    "h1": {
      "$value": {
        "fontFamily": [
          "Pretendard Variable",
          "Pretendard",
          "sans-serif"
        ],
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.25
      }
    },
    "h2": {
      "$value": {
        "fontFamily": [
          "Pretendard Variable",
          "Pretendard",
          "sans-serif"
        ],
