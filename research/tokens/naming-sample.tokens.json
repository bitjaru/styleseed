        },
        "selected": {
          "$value": "{semantic.bg.brand.subtle}"
        }
      },
      "fg": {
        "default": {
          "$value": "{semantic.fg.subtle}"
        },
        "selected": {
          "$value": "{semantic.fg.brand.base}"
        }
      },
      "bd": {
        "default": {
          "$value": "{semantic.bd.subtle}"
