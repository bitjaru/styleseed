  "component": {
    "$type": "color",
    "button": {
      "primary": {
        "bg": {
          "default": {
            "$value": "{semantic.bg.brand.base}"
          },
          "hover": {
            "$value": "{semantic.bg.brand.emphasis}"
          },
          "disabled": {
            "$value": "{semantic.bg.muted}"
          }
        },
        "fg": {
          "default": {
            "$value": "{semantic.fg.inverse}"
          },
          "disabled": {
            "$value": "{semantic.fg.muted}"
          }
        }
      },
      "secondary": {
        "bg": {
          "default": {
            "$value": "{semantic.bg.muted}"
          },
          "hover": {
            "$value": "{semantic.bg.subtle}"
          }
        },
        "fg": {
