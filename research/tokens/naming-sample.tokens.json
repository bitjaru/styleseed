  "semantic": {
    "$type": "color",
    "fg": {
      "base": {
        "$value": "{primitive.neutral.900}"
      },
      "subtle": {
        "$value": "{primitive.neutral.700}"
      },
      "muted": {
        "$value": "{primitive.neutral.500}"
      },
      "emphasis": {
        "$value": "{primitive.brand.700}"
      },
      "inverse": {
        "$value": "{primitive.white}"
      },
